{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-framework",
    "description": "A developer-friendly package for creating advanced Wordpress themes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {
        "bacon/bacon-qr-code": "^3.0",
        "pragmarx/google2fa": "^9.0",
        "mirror-and-mountain/meros-foundations": "^1.0"
    },
    "require-dev": {
        "illuminate/testing": "^13.0",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "MM\\Meros\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "test:integration": "phpunit -c phpunit.integration.xml"
    },
    "autoload": {
        "psr-4": {
            "MM\\Meros\\": "src/",
            "MM\\Meros\\App\\": "src/app/",
            "MM\\Meros\\Contracts\\": "src/contracts/",
            "MM\\Meros\\Registers\\": "src/registers/",
            "MM\\Meros\\Facades\\": "src/facades/",
            "MM\\Meros\\Services\\": "src/services/",
            "MM\\Meros\\Support\\": "src/support/",
            "MM\\Meros\\Scripts\\": "src/scripts/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
