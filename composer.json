{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-framework",
    "description": "A developer-friendly package for creating advanced Wordpress themes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {
        "roots/acorn": "^6.2",
        "livewire/livewire": "^4.3.3",
        "symfony/uid": "^8.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "MM\\Meros\\": "src/",
            "MM\\Meros\\App\\": "src/app/",
            "MM\\Meros\\Facades\\": "src/facades/",
            "MM\\Meros\\Services\\": "src/services/",
            "MM\\Meros\\Support\\": "src/support/",
            "MM\\Meros\\Scripts\\": "src/scripts/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
