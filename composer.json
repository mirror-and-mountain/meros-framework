{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-framework",
    "description": "A developer-friendly package for creating advanced Wordpress themes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {
        "bacon/bacon-qr-code": "^3.0",
        "pragmarx/google2fa": "^9.0",
        "livewire/livewire": "^4.4.8",
        "symfony/uid": "^8.1.9",
        "mirror-and-mountain/meros-foundations": "@dev"
    },
    "autoload": {
        "psr-4": {
            "MM\\Meros\\": "src/",
            "MM\\Meros\\App\\": "src/app/",
            "MM\\Meros\\Contracts\\": "src/contracts/",
            "MM\\Meros\\Registers\\": "src/registers/",
            "MM\\Meros\\Facades\\": "src/facades/",
            "MM\\Meros\\Services\\": "src/services/",
            "MM\\Meros\\Support\\": "src/support/",
            "MM\\Meros\\Scripts\\": "src/scripts/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../meros-foundations"
        }
    ]
}
