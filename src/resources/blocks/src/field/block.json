{
    "$schema": "https://json.schemastore.org/block.json",
    "apiVersion": 3,
    "name": "meros/field",
    "version": "0.1.0",
    "title": "Field",
    "category": "widgets",
    "icon": "format-gallery",
    "description": "Renders a field for use in forms and other input contexts.",
    "textdomain": "meros-theme",
    "example": {},
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "render": "file:./render.php",
    "attributes": {
        "wrapper": {
            "type": "string",
            "default": "meros::components.fields.wrappers.site-field"
        },
        "component": {
            "type": "string",
            "default": "meros::components.fields.input"
        },
        "attrs": {
            "type": "object",
            "default": {
                "variation": "text",
                "name": "example_field",
                "id": "example_field",
                "label": "Example Field",
                "description": "This is an example field.",
                "value": "",
                "placeholder": "Enter a value"
            }
        }
    }
}