# WordPress Site configuration
THEME_SLUG="{{THEME_SLUG}}"
SITE_TITLE="{{SITE_TITLE}}"
SITE_URL="{{SITE_URL}}"

# WordPress Site admin credentials
ADMIN_USER="{{ADMIN_USER}}"
ADMIN_PASSWORD="{{ADMIN_PASSWORD}}"
ADMIN_EMAIL="{{ADMIN_EMAIL}}"

# WordPress Database configuration
DB_NAME="{{DB_NAME}}"
DB_HOST="{{DB_HOST}}"
DB_USER="{{DB_USER}}"
DB_PASSWORD="{{DB_PASSWORD}}"
DB_ROOT_PASSWORD="{{DB_ROOT_PASSWORD}}"
DB_PREFIX="{{DB_PREFIX}}"
DB_CHARSET="{{DB_CHARSET}}"
DB_COLLATE="{{DB_COLLATE}}"

# Ports configuration
WP_PORT="{{WP_PORT}}"
PHPMYADMIN_PORT="{{PHPMYADMIN_PORT}}"
MAILPIT_SMTP_PORT="{{MAILPIT_SMTP_PORT}}"
MAILPIT_UI_PORT="{{MAILPIT_UI_PORT}}"


# Used for apache user www-data to match host user permissions. 
# Needed for Podman setups only. Defaults to 501 (macOS) if not set.
LOCAL_USER_ID="501"
LOCAL_GROUP_ID="501"

# If using podman for devcontainers, set the following settings in vs code's settings.json:
# "dev.containers.dockerPath": "podman",
# "dev.containers.dockerComposePath": "podman-compose",